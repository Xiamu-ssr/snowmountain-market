{
  "name": "snowmountain-market",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "catalog": "node scripts/build-catalog.mjs",
    "sync:external": "node scripts/sync-external.mjs",
    "dev": "pnpm catalog && vite --host 127.0.0.1 --port 4320",
    "build": "pnpm catalog && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1 --port 4320",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.525.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/node": "^24.0.15",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.2"
  }
}
